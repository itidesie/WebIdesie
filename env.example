# ---------------------------------------------------------------------------
# Variables de entorno de IDESIE
#
# Copia este fichero a .env.local (con el punto delante) y rellena los
# valores reales. .env.local está en .gitignore (patrón `.env*.local`) —
# nunca se sube al repositorio.
#
# NINGUNA es obligatoria para desarrollar: si falta una, ese servicio arranca
# en MODO MOCK (datos ficticios, envíos descartados) y el servidor te avisa por
# consola al arrancar. En producción el modo mock NO se activa nunca: allí una
# variable ausente hace fallar el arranque, que es el comportamiento deseado.
# ---------------------------------------------------------------------------

# --- Supabase (única base de datos del proyecto — Neon se retiró por completo) ---
# Los tres valores están juntos en supabase.com → tu proyecto → Project
# Settings → API (URL y anon key) y → Project Settings → API → service_role
# (revela la clave con el botón "Reveal"). No hace falta ninguna cadena de
# conexión Postgres directa (ni DATABASE_URL ni POSTGRES_URL) — todo el
# acceso a datos del proyecto pasa por @supabase/supabase-js vía estas tres.

# Project URL. Público a propósito (prefijo NEXT_PUBLIC_): identifica el
# proyecto, no da acceso a nada por sí solo.
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key. También pensada para ser pública — cualquier acceso que
# haga pasa por Row Level Security. Hoy nada del proyecto la usa todavía
# (ver lib/supabase/browser.ts), pero debe estar configurada para cuando algo
# la necesite.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key. 🔴 NUNCA lleva prefijo NEXT_PUBLIC_ y NUNCA debe
# aparecer en código que se ejecute en el navegador — bypassa Row Level
# Security por completo. Solo la usa lib/supabase/server.ts (marcado
# "server-only", falla el build si algo del cliente intenta importarlo).
# Es la ÚNICA llave de mock para blog, tienda/productos, solicitudes de
# admisión y leads — comparten un solo proyecto de Supabase, así que
# comparten una sola credencial (antes eran DATABASE_URL y POSTGRES_URL
# por separado, cuando la base de datos era Neon).
# Sin ella: cada una de esas funcionalidades sirve datos de ejemplo o
# rechaza la operación, y se registra en el log del servidor en vez de
# fallar en silencio.
SUPABASE_SERVICE_ROLE_KEY=

# --- Secreto propio de la aplicación (OBLIGATORIO, sin fallback) -----------
# 🔒 La app NO ARRANCA si falta (ver lib/env.ts / instrumentation.ts).
# Independiente de Supabase: rotar una clave de Supabase ya no afecta al
# limitador, y una fuga de la service_role key ya no permite falsificarlo.
# Generar con:   openssl rand -base64 48
# Debe ser distinto de cualquier clave de Supabase.
# Ponerlo en .env.local y en Vercel (Production, Preview y Development).
#
# HMAC de las claves (IP, email) del rate limiting (lib/rate-limit.ts).
# Cambiarlo reinicia los contadores.
RATE_LIMIT_SECRET=

# --- Email transaccional (Resend) ------------------------------------------
# 🔴 EN MODO MOCK A PROPÓSITO — todavía no hay clave real (pendiente).
# Clave de API de https://resend.com (empieza por "re_").
# Usada en: leads, contacto, candidaturas, admisión, envío de catálogo en PDF
# (/api/send-catalog, migrado de Brevo el 2026-09-05) y solicitudes de baja.
# Sin ella: los formularios responden con éxito simulado y no se envía nada
# — solo se registra en el log del servidor. Añadir esta variable es LO
# ÚNICO que hace falta para activar el envío real: no requiere tocar código
# (ver lib/resend.ts y lib/leads-db.ts).
RESEND_API_KEY=

# 🔒 Remitente de TODOS los emails del sitio (lib/resend.ts → getResendFrom()).
# Debe ser una dirección de un DOMINIO VERIFICADO en Resend (Resend → Domains),
# p. ej.  info@tu-dominio.com   o   IDESIE <info@tu-dominio.com>
# Si en producción falta, o sigue siendo el remitente de pruebas
# onboarding@resend.dev, se registra un error claro en el log al arrancar y en
# el primer envío: con ese remitente Resend solo entrega al dueño de la cuenta,
# así que los usuarios NO recibirían ninguna confirmación aunque el formulario
# responda "éxito".
RESEND_FROM_EMAIL=

# --- URL pública del sitio -------------------------------------------------
# Base para URLs canónicas, Open Graph y sitemap.
# Si falta, se usa https://idesie.com (ver app/layout.tsx).
# En local: http://localhost:3000
NEXT_PUBLIC_BASE_URL=

# --- Meta Pixel (tracking de campañas de pago, solo /landing) --------------
# ID numérico del píxel — Meta Business Suite → Events Manager → tu píxel →
# Configuración. Público a propósito (prefijo NEXT_PUBLIC_): el propio script
# del píxel lo expone en el HTML, no es un secreto.
# Usado en: components/landing/meta-pixel.tsx (solo /landing).
# Sin ella: el componente no renderiza nada, no falla.
# El píxel además nunca se dispara en desarrollo ni en localhost aunque esta
# variable esté puesta — solo en producción real, para no ensuciar los datos
# de Meta con pruebas locales.
NEXT_PUBLIC_META_PIXEL_ID=
